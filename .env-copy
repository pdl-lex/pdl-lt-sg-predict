# Sachgruppen classification – configuration
# Rename this file to .env and adjust the settings as needed.

# Directory for storing trained models.
# If you run the projet in dev mode (reflex run), then the saving of models will 
# triggers a hot-reload, which will cause the training to stop.
# To avoid this, set MODELS_DIR to a directory outside the project folder.
# Default (if not set): ~/.pdl-sg-predict/models
MODELS_DIR=models

# Enable training UI (True/False).
# Set to False on production systems without GPU or sufficient compute.
ENABLE_TRAINING=True

# E-mail notification after CLI training (optional)
# Used only by the CLI (sachgruppen_classifier.py --notify EMAIL).
# Example for Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587,
#   SMTP_USER=your@gmail.com, SMTP_PASSWORD=<App-Password>
#   (create App-Password at https://myaccount.google.com/apppasswords)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
