# Zugang zur Wörterbuch-Datenbank (wbdb) für scripts/extract_data.py --quelle db.
# Diese Datei nach .env kopieren und das Passwort eintragen — .env ist gitignored,
# das Passwort gehört nicht ins Repository.
#
# Die Werte stehen in pdl-lt-wbdb/.env; die Datenbank läuft dort in Docker:
#   cd <...>/Repos/pdl-lt-wbdb && docker compose up -d
#
# Siehe scripts/Readme Access WBDB.md

POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=wbdb
POSTGRES_USER=pdlwh
POSTGRES_PASSWORD=
